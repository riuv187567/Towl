<Window x:Class="Towl.WPF.TowlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Towl.WPF"
        mc:Ignorable="d"
        Title="Towl" Height="256" Width="256" Topmost="True" ResizeMode="NoResize" Background="#1F2023">
    <Grid>
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock Name="MainTimeText" Text="00:00:00" Margin="0,0,0,0" FontFamily="Arial" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            <TextBlock Name="SecondaryTimeText" Text="00:00:00" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#C4C5C6"/>
        </WrapPanel>
    </Grid>
</Window>
